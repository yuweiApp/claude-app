{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动应用",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/gateway",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/gateway/src/index.ts",
      "autoAttachChildProcesses": false,
      "console": "internalConsole",
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart",
      "serverReadyAction": {
        "pattern": "Server listening at (https?://[^\\s\"\\\\]+)",
        "action": "startDebugging",
        "killOnServerStop": true,
        "config": {
          "name": "网页客户端",
          "type": "node",
          "request": "launch",
          "cwd": "${workspaceFolder}/client",
          "program": "${workspaceFolder}/client/node_modules/vite/bin/vite.js",
          "args": ["--open"],
          "console": "integratedTerminal",
          "skipFiles": ["<node_internals>/**"]
        }
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "启动桌面应用",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/desktop",
      "preLaunchTask": "编译桌面版",
      "runtimeExecutable": "${workspaceFolder}/desktop/node_modules/.bin/electron",
      "windows": { "runtimeExecutable": "${workspaceFolder}/desktop/node_modules/.bin/electron.cmd" },
      "args": ["."],
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart",
      "outFiles": ["${workspaceFolder}/desktop/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
