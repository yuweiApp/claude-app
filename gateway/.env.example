# 复制成 .env.local 修改（.env.local 不提交）。优先级：.env.local > .env > 系统环境变量

# ---- 网关 ----
# HOST=127.0.0.1
# PORT=8788
# 设置后所有接口要求 Authorization: Bearer <token>（对外开放时必须设置）
# API_TOKEN=

# 普通会话（没选文件夹）的工作目录都建在这下面，上传的附件也在这里。默认是用户数据目录下的 claude-app/workspace：
# Windows %LOCALAPPDATA%\claude-app\workspace，macOS ~/Library/Application Support/claude-app/workspace，
# Linux ~/.local/share/claude-app/workspace。不要放在 git 仓库里（模型会看到仓库的 git 状态）或临时目录里（会被系统清理）
# WORKSPACE_DIR=
# Claude Code 的配置目录（会话记录、settings、skills、memory），默认 gateway/.data/claude-home，和本机的 ~/.claude 分开
# CLAUDE_CONFIG_DIR=

# ---- 模型（Anthropic Messages API 格式），见 docs/README.md「模型接入」 ----
# newapi 根地址（不带 /v1），或 DeepSeek 官方的 https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
# 以 Authorization: Bearer 发送；接口要求 x-api-key 时改用 ANTHROPIC_API_KEY
ANTHROPIC_AUTH_TOKEN=
# 默认模型（新会话用它，模型菜单里排第一）。模型菜单读接口的 /v1/models，去掉图片、视频、语音等非对话模型；
# Claude Code 的 opus / sonnet / haiku 档位（后台生成标题、WebFetch 总结等）网关会指向这个模型，不用另外设
ANTHROPIC_MODEL=gpt-6-luna
# 模型菜单只保留 id 匹配这个正则的（不区分大小写），例如 ^(gpt|deepseek|kimi)
# MODELS_FILTER=
# 默认 1：不发遥测、错误上报、更新检查
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ---- 会话 ----
# 新会话的权限模式：default / acceptEdits / plan / bypassPermissions / dontAsk / auto，默认 bypassPermissions（完全访问）
# DEFAULT_PERMISSION_MODE=bypassPermissions
# 推理强度：low / medium / high / xhigh / max，默认 high（同 Claude 桌面版）
# DEFAULT_EFFORT=high
# 禁用的内置工具，逗号分隔，默认 WebSearch（Anthropic 服务端工具，第三方模型用不了）
# DISALLOWED_TOOLS=WebSearch
# 追加到 Claude Code 系统提示后面的说明，不设或设成空串就不追加。
# SDK 会话拿到的 Claude Code 提示词是精简版，没有完整版里「调用工具前用一句话说明要做什么、做事过程中简短汇报」那段；
# Claude 模型不说也会边做边说，GPT 类模型（如 gpt-6-luna）不被要求就一句不说，工具调用之间没有任何文字。
# 加上下面这句后会先说一句再调用工具（Codex 的提示词里也有同样的要求：Preamble messages）
APPEND_SYSTEM_PROMPT="用户看不到你的思考，只能看到你输出的文字和工具调用。调用工具前，用一句话说明你接下来要做什么；做事过程中，有重要发现或改变方向时，用一句话告诉用户。"
# 空闲多久关闭子进程（毫秒，默认 30 分钟）
# SESSION_IDLE_MS=1800000
# 同时活跃的会话上限
# MAX_ACTIVE_SESSIONS=8
# 权限请求多久没回复自动拒绝（毫秒，默认 10 分钟）
# PERMISSION_TIMEOUT_MS=600000
# 每个会话保留多少条事件用于断线续传
# EVENT_BUFFER_SIZE=5000

# ---- 对话日志（用户的原始内容和模型的实际响应，排查问题用） ----
# 设成 0 关闭
# LOG_ENABLED=1
# 日志目录，默认 gateway/.data/logs
# LOG_DIR=
# 单个文件的大小上限（MB），超过换下一个文件
# LOG_MAX_FILE_MB=20
# 所有日志（含保存的图片）的总大小上限（MB），超过从最旧的文件开始删
# LOG_MAX_TOTAL_MB=500
# 保留天数，更早的文件删掉
# LOG_RETENTION_DAYS=14
# 单条记录的大小上限（KB），超过只留开头一段
# LOG_MAX_ENTRY_KB=512

# ---- 附件 ----
# 单个上传文件的大小上限（MB）
# MAX_UPLOAD_MB=20
