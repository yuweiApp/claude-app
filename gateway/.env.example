# 复制成 .env.local 修改（.env.local 不提交）。优先级：.env.local > .env > 系统环境变量

# ---- 网关 ----
# HOST=127.0.0.1
# PORT=8788
# 设置后所有接口要求 Authorization: Bearer <token>（对外开放时必须设置）
# API_TOKEN=

# 智能体的工作目录，默认 gateway/.data/workspace
# WORKSPACE_DIR=
# Claude Code 的配置目录（会话记录、settings、skills、memory），默认 gateway/.data/claude-home，和本机的 ~/.claude 分开
# CLAUDE_CONFIG_DIR=

# ---- 模型（Anthropic Messages API 格式），见 docs/README.md「模型接入」 ----
# newapi 根地址（不带 /v1），或 DeepSeek 官方的 https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
# 以 Authorization: Bearer 发送；接口要求 x-api-key 时改用 ANTHROPIC_API_KEY
ANTHROPIC_AUTH_TOKEN=
# 主模型，以及 Claude Code 各档位别名映射到的模型（不填会去请求 claude-* 模型）
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
# 默认 1：不发遥测、错误上报、更新检查
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ---- 会话 ----
# 新会话的权限模式：default / acceptEdits / plan / bypassPermissions / dontAsk / auto
# DEFAULT_PERMISSION_MODE=default
# 禁用的内置工具，逗号分隔，默认 WebSearch（Anthropic 服务端工具，第三方模型用不了）
# DISALLOWED_TOOLS=WebSearch
# 追加到 Claude Code 系统提示后面的说明
# APPEND_SYSTEM_PROMPT=
# 空闲多久关闭子进程（毫秒，默认 30 分钟）
# SESSION_IDLE_MS=1800000
# 同时活跃的会话上限
# MAX_ACTIVE_SESSIONS=8
# 权限请求多久没回复自动拒绝（毫秒，默认 10 分钟）
# PERMISSION_TIMEOUT_MS=600000
# 每个会话保留多少条事件用于断线续传
# EVENT_BUFFER_SIZE=5000

# ---- 附件 ----
# 单个上传文件的大小上限（MB）
# MAX_UPLOAD_MB=20
# 图片附件同时作为 image 块发给模型（模型要能看图，DeepSeek 文本模型不要开）
# IMAGE_INPUT=false
