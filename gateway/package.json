{
  "name": "claude-app-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP + SSE gateway for the Claude Agent SDK",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fetch-core": "node scripts/fetch-core.mjs",
    "postinstall": "node scripts/fetch-core.mjs --optional"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.331",
    "@fastify/multipart": "^10.1.7",
    "@fastify/websocket": "^11.3.7",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/headless": "6.0.0",
    "acorn": "8.19.0",
    "agent-desktop": "1.2.0",
    "fastify": "^5.12.8",
    "iconv-lite": "^0.7.3",
    "playwright-core": "1.65.0",
    "sharp": "0.35.5",
    "ssh2": "1.17.0",
    "tldts": "7.4.19",
    "undici": "7.30.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ssh2": "1.15.6",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tldts-core": "7.4.19"
  }
}
