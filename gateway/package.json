{
  "name": "claude-app-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP + SSE gateway for the Claude Agent SDK",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.317",
    "@fastify/multipart": "^10.1.7",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
