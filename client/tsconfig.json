{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      // 复用网关的事件类型和 SDK 的消息类型；@gateway/shared 下不依赖 Node 的代码也能 import（vite.config.ts 里有同样的别名）
      "@gateway/*": ["../gateway/src/*"],
      "@anthropic-ai/claude-agent-sdk": ["../gateway/node_modules/@anthropic-ai/claude-agent-sdk/sdk.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
